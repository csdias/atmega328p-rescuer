<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    API da bancada. Existe para os front ends que não correm no PC da bancada — o
    React, e depois o React Native — chegarem ao mesmo hardware que o WPF, através
    dos serviços do Core.

    net10.0-windows como o Core: quem serve esta API é o PC onde estão o CH340, o
    USBAsp e o avrdude.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ATMegaPestaV1.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ATMegaPestaV1.Core\ATMegaPestaV1.Core.csproj" />
  </ItemGroup>

</Project>
