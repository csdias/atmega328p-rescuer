<Window x:Class="ATMegaPestaV1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="ATmega328P Rescuer Pesta V1"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinHeight="500" MinWidth="750"
        Background="{DynamicResource BrushFundoJanela}"
        FontFamily="{DynamicResource FonteUI}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Botao principal -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushBtnClaro}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBtnClaroText}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="28,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- A moldura so existe no tema vintage (EspessuraBotao=1): um botao
                             cinzento sem contorno sobre fundo cinzento desaparece. La o
                             relevo e saliente, para o botao se ler como premivel. Nos temas
                             claro/escuro o botao e preenchido e a espessura fica a 0. -->
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RaioMedio}"
                                BorderBrush="{DynamicResource BrushRelevoElevado}"
                                BorderThickness="{DynamicResource EspessuraBotao}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushBtnClaroHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource BrushBtnDesativ}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushBtnDesativText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu lateral (drawer) -->
        <sys:Double x:Key="LarguraMenuFechado">56</sys:Double>
        <sys:Double x:Key="LarguraMenuAberto">250</sys:Double>

        <Style x:Key="MenuButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoNormal}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Menu"/>
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushRealce}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushRealce}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushMenuAccento}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextoTitulo}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Com o drawer aberto o rotulo ja esta visivel; a tooltip seria redundante -->
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=MenuDrawer}" Value="True">
                    <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Icone: largura fixa para ficar alinhado com o drawer fechado -->
        <Style x:Key="MenuIcon" TargetType="TextBlock">
            <Setter Property="Width" Value="24"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Rotulo: so aparece com o drawer aberto -->
        <Style x:Key="MenuLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=MenuDrawer}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                 BeginTime="0:0:0.08" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Drawer: fechado mostra apenas icones, expande sobre o conteudo ao passar o rato -->
        <Style x:Key="MenuDrawerStyle" TargetType="Border">
            <Setter Property="Width" Value="{StaticResource LarguraMenuFechado}"/>
            <Setter Property="Background" Value="{DynamicResource BrushFundoMenu}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushSeparador}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Direction="0"
                                      Color="#000000" Opacity="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="{StaticResource LarguraMenuAberto}" Duration="0:0:0.20">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                 To="0.35" Duration="0:0:0.20"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="{StaticResource LarguraMenuFechado}" Duration="0:0:0.20">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                 To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusEllipse" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stroke" Value="{DynamicResource BrushTextoSubtil}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ==================== PAINEL VERIFICACAO ==================== -->
        <Grid x:Name="PanelVerificacao" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Verificação de Dispositivos"
                       Foreground="{DynamicResource BrushTextoTitulo}" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <!-- CH340 -->
            <Border Grid.Row="2" Background="{DynamicResource BrushFundoCard}" CornerRadius="{DynamicResource RaioGrande}"
                    BorderBrush="{DynamicResource BrushRelevoAfundado}" BorderThickness="{DynamicResource EspessuraCartao}"
                    Padding="20,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Ellipse x:Name="LedCH340" Style="{StaticResource StatusEllipse}" Fill="{DynamicResource BrushTextoSubtil}"/>
                        <TextBlock Foreground="{DynamicResource BrushTextoTitulo}" FontSize="16" VerticalAlignment="Center"
                                   Text="CH340 — Conversor USB-Serial"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCH340Detail" Grid.Row="2"
                               Foreground="{DynamicResource BrushTextoNormal}" FontSize="13" VerticalAlignment="Center" Margin="30,0,0,0"
                               Text="Estado: A aguardar verificação..."/>
                </Grid>
            </Border>

            <!-- USBAsp -->
            <Border Grid.Row="3" Background="{DynamicResource BrushFundoCard}" CornerRadius="{DynamicResource RaioGrande}"
                    BorderBrush="{DynamicResource BrushRelevoAfundado}" BorderThickness="{DynamicResource EspessuraCartao}"
                    Padding="20,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Ellipse x:Name="LedUSBAsp" Style="{StaticResource StatusEllipse}" Fill="{DynamicResource BrushTextoSubtil}"/>
                        <TextBlock Foreground="{DynamicResource BrushTextoTitulo}" FontSize="16" VerticalAlignment="Center"
                                   Text="USBAsp — Programador AVR"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtUSBaspDetail" Grid.Row="2"
                               Foreground="{DynamicResource BrushTextoNormal}" FontSize="13" VerticalAlignment="Center" Margin="30,0,0,0"
                               Text="Estado: A aguardar verificação..."/>
                </Grid>
            </Border>

            <!-- Signature -->
            <Border Grid.Row="4" Background="{DynamicResource BrushFundoCard}" CornerRadius="{DynamicResource RaioGrande}"
                    BorderBrush="{DynamicResource BrushRelevoAfundado}" BorderThickness="{DynamicResource EspessuraCartao}"
                    Padding="20,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Ellipse x:Name="LedSignature" Style="{StaticResource StatusEllipse}" Fill="{DynamicResource BrushTextoSubtil}"/>
                        <TextBlock Foreground="{DynamicResource BrushTextoTitulo}" FontSize="16" VerticalAlignment="Center"
                                   Text="Assinatura — Identificação do Equipamento"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSignatureDetail" Grid.Row="2"
                               Foreground="{DynamicResource BrushTextoNormal}" FontSize="13" VerticalAlignment="Center" Margin="30,0,0,0"
                               Text="Estado: A aguardar verificação..."/>
                </Grid>
            </Border>

            <TextBlock x:Name="TxtTentativas" Grid.Row="6"
                       Foreground="{DynamicResource BrushTextoNormal}" FontSize="13" HorizontalAlignment="Center"/>

            <TextBlock x:Name="TxtMensagem" Grid.Row="7"
                       Foreground="#F38BA8" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,10,0,0"/>

            <StackPanel Grid.Row="9" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button x:Name="BtnVerificar" Style="{StaticResource ActionButton}"
                        Content="Verificar Dispositivos" Click="BtnVerificar_Click"/>
            </StackPanel>

            <TextBlock x:Name="TxtRodape" Grid.Row="10"
                       Foreground="{DynamicResource BrushTextoSubtil}" FontSize="12" HorizontalAlignment="Center"/>
        </Grid>

        <!-- ==================== PAINEL PRINCIPAL ==================== -->
        <Grid x:Name="PanelPrincipal" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushFundoHeader}" Padding="20,14">
                <Grid>
                    <TextBlock Foreground="{DynamicResource BrushTextoTitulo}" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Text="ATmega328P Rescuer Pesta V1"/>
                    <TextBlock x:Name="TxtHeaderDataHora" Foreground="{DynamicResource BrushTextoNormal}" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Corpo: Menu + Conteudo -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Calha fixa: o drawer aberto sobrepoe-se ao conteudo em vez de o empurrar -->
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Conteudo -->
                <ContentControl x:Name="ConteudoPrincipal" Grid.Column="1"/>

                <!-- Menu lateral (drawer) -->
                <Border x:Name="MenuDrawer" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="10"
                        Style="{StaticResource MenuDrawerStyle}">
                    <StackPanel Margin="0,10,0,0">
                        <RadioButton x:Name="MenuTestes" Style="{StaticResource MenuButton}"
                                     Tag="Teste de Funcionalidades"
                                     IsChecked="True"
                                     Checked="MenuItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Style="{StaticResource MenuIcon}"/>
                                <TextBlock Text="Teste de Funcionalidades" Style="{StaticResource MenuLabel}"
                                           x:Name="TxtMenuTestes"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="MenuProgramacao" Style="{StaticResource MenuButton}"
                                     Tag="Programação de Alta Tensão"
                                     Checked="MenuItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Style="{StaticResource MenuIcon}"/>
                                <TextBlock Text="Programação de Alta Tensão" Style="{StaticResource MenuLabel}"
                                           x:Name="TxtMenuProgramacao"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="MenuConfiguracoes" Style="{StaticResource MenuButton}"
                                     Tag="Configurações"
                                     Checked="MenuItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☰" Style="{StaticResource MenuIcon}"/>
                                <TextBlock Text="Configurações" Style="{StaticResource MenuLabel}"
                                           x:Name="TxtMenuConfiguracoes"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Rodape -->
            <Border Grid.Row="2" Background="{DynamicResource BrushFundoHeader}" Padding="16,10">
                <Grid>
                    <TextBlock Foreground="{DynamicResource BrushTextoSubtil}" FontSize="11" VerticalAlignment="Center"
                               Text="ATmega328P Rescuer Pesta V1"/>
                    <TextBlock Foreground="{DynamicResource BrushTextoSubtil}" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="v1.0.0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
