<Window x:Class="ATMegaPestaV1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="ATmega328P Rescuer Pesta V1"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinHeight="500" MinWidth="750"
        Background="{DynamicResource BrushWindowBackground}"
        FontFamily="{DynamicResource FontUI}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Primary button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushBtnLight}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBtnLightText}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="28,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- The frame only exists in the vintage theme (ButtonThickness=1): a grey
                             button with no outline on a grey background disappears. There the
                             bevel is raised, so the button reads as pressable. In the light/dark
                             themes the button is filled and the thickness stays at 0. -->
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                BorderBrush="{DynamicResource BrushBevelRaised}"
                                BorderThickness="{DynamicResource ButtonThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushBtnLightHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource BrushBtnDisabled}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushBtnDisabledText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Side menu (drawer) -->
        <sys:Double x:Key="MenuWidthClosed">56</sys:Double>
        <sys:Double x:Key="MenuWidthOpen">250</sys:Double>

        <Style x:Key="MenuButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextNormal}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Menu"/>
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHighlight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHighlight}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushMenuAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextTitle}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- With the drawer open the label is already visible; the tooltip would be redundant -->
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=MenuDrawer}" Value="True">
                    <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Icon: fixed width so it lines up with the closed drawer -->
        <Style x:Key="MenuIcon" TargetType="TextBlock">
            <Setter Property="Width" Value="24"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Label: only appears with the drawer open -->
        <Style x:Key="MenuLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=MenuDrawer}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                 BeginTime="0:0:0.08" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Drawer: closed it shows icons only, expands over the content on hover -->
        <Style x:Key="MenuDrawerStyle" TargetType="Border">
            <Setter Property="Width" Value="{StaticResource MenuWidthClosed}"/>
            <Setter Property="Background" Value="{DynamicResource BrushMenuBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushSeparator}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Direction="0"
                                      Color="#000000" Opacity="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="{StaticResource MenuWidthOpen}" Duration="0:0:0.20">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                 To="0.35" Duration="0:0:0.20"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="{StaticResource MenuWidthClosed}" Duration="0:0:0.20">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                 To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusEllipse" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stroke" Value="{DynamicResource BrushTextSubtle}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ==================== VERIFICATION PANEL ==================== -->
        <Grid x:Name="VerificationPanel" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Verificação de Dispositivos"
                       Foreground="{DynamicResource BrushTextTitle}" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <!-- CH340 -->
            <Border Grid.Row="2" Background="{DynamicResource BrushCardBackground}" CornerRadius="{DynamicResource RadiusLarge}"
                    BorderBrush="{DynamicResource BrushBevelSunken}" BorderThickness="{DynamicResource CardThickness}"
                    Padding="20,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Ellipse x:Name="LedCH340" Style="{StaticResource StatusEllipse}" Fill="{DynamicResource BrushTextSubtle}"/>
                        <TextBlock Foreground="{DynamicResource BrushTextTitle}" FontSize="16" VerticalAlignment="Center"
                                   Text="CH340 — Conversor USB-Serial"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCH340Detail" Grid.Row="2"
                               Foreground="{DynamicResource BrushTextNormal}" FontSize="13" VerticalAlignment="Center" Margin="30,0,0,0"
                               Text="Estado: A aguardar verificação..."/>
                </Grid>
            </Border>

            <!-- USBAsp -->
            <Border Grid.Row="3" Background="{DynamicResource BrushCardBackground}" CornerRadius="{DynamicResource RadiusLarge}"
                    BorderBrush="{DynamicResource BrushBevelSunken}" BorderThickness="{DynamicResource CardThickness}"
                    Padding="20,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Ellipse x:Name="LedUSBAsp" Style="{StaticResource StatusEllipse}" Fill="{DynamicResource BrushTextSubtle}"/>
                        <TextBlock Foreground="{DynamicResource BrushTextTitle}" FontSize="16" VerticalAlignment="Center"
                                   Text="USBAsp — Programador AVR"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtUSBaspDetail" Grid.Row="2"
                               Foreground="{DynamicResource BrushTextNormal}" FontSize="13" VerticalAlignment="Center" Margin="30,0,0,0"
                               Text="Estado: A aguardar verificação..."/>
                </Grid>
            </Border>

            <!-- Signature -->
            <Border Grid.Row="4" Background="{DynamicResource BrushCardBackground}" CornerRadius="{DynamicResource RadiusLarge}"
                    BorderBrush="{DynamicResource BrushBevelSunken}" BorderThickness="{DynamicResource CardThickness}"
                    Padding="20,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Ellipse x:Name="LedSignature" Style="{StaticResource StatusEllipse}" Fill="{DynamicResource BrushTextSubtle}"/>
                        <TextBlock Foreground="{DynamicResource BrushTextTitle}" FontSize="16" VerticalAlignment="Center"
                                   Text="Assinatura — Identificação do Equipamento"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSignatureDetail" Grid.Row="2"
                               Foreground="{DynamicResource BrushTextNormal}" FontSize="13" VerticalAlignment="Center" Margin="30,0,0,0"
                               Text="Estado: A aguardar verificação..."/>
                </Grid>
            </Border>

            <TextBlock x:Name="TxtAttempts" Grid.Row="6"
                       Foreground="{DynamicResource BrushTextNormal}" FontSize="13" HorizontalAlignment="Center"/>

            <TextBlock x:Name="TxtMessage" Grid.Row="7"
                       Foreground="{DynamicResource BrushPinError}" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,10,0,0"/>

            <StackPanel Grid.Row="9" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button x:Name="BtnVerify" Style="{StaticResource ActionButton}"
                        Content="Verificar Dispositivos" Click="BtnVerify_Click"/>
            </StackPanel>

            <TextBlock x:Name="TxtFooter" Grid.Row="10"
                       Foreground="{DynamicResource BrushTextSubtle}" FontSize="12" HorizontalAlignment="Center"/>
        </Grid>

        <!-- ==================== MAIN PANEL ==================== -->
        <Grid x:Name="MainPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBackground}" Padding="20,14">
                <Grid>
                    <TextBlock Foreground="{DynamicResource BrushTextTitle}" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Text="ATmega328P Rescuer Pesta V1"/>
                    <TextBlock x:Name="TxtHeaderDateTime" Foreground="{DynamicResource BrushTextNormal}" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Body: menu + content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Fixed gutter: the open drawer overlays the content instead of pushing it -->
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Content -->
                <ContentControl x:Name="MainContent" Grid.Column="1"/>

                <!-- Side menu (drawer) -->
                <Border x:Name="MenuDrawer" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="10"
                        Style="{StaticResource MenuDrawerStyle}">
                    <StackPanel Margin="0,10,0,0">
                        <RadioButton x:Name="MenuTests" Style="{StaticResource MenuButton}"
                                     Tag="Teste de Funcionalidades"
                                     IsChecked="True"
                                     Checked="MenuItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Style="{StaticResource MenuIcon}"/>
                                <TextBlock Text="Teste de Funcionalidades" Style="{StaticResource MenuLabel}"
                                           x:Name="TxtMenuTests"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="MenuProgramming" Style="{StaticResource MenuButton}"
                                     Tag="Programação de Alta Tensão"
                                     Checked="MenuItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Style="{StaticResource MenuIcon}"/>
                                <TextBlock Text="Programação de Alta Tensão" Style="{StaticResource MenuLabel}"
                                           x:Name="TxtMenuProgramming"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="MenuSettings" Style="{StaticResource MenuButton}"
                                     Tag="Configurações"
                                     Checked="MenuItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☰" Style="{StaticResource MenuIcon}"/>
                                <TextBlock Text="Configurações" Style="{StaticResource MenuLabel}"
                                           x:Name="TxtMenuSettings"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BrushHeaderBackground}" Padding="16,10">
                <Grid>
                    <TextBlock Foreground="{DynamicResource BrushTextSubtle}" FontSize="11" VerticalAlignment="Center"
                               Text="ATmega328P Rescuer Pesta V1"/>
                    <TextBlock Foreground="{DynamicResource BrushTextSubtle}" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="v1.0.0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
