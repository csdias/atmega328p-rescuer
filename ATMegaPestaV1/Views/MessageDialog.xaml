<Window x:Class="ATMegaPestaV1.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATmega328P Rescuer Pesta V1"
        SizeToContent="Height"
        MaxHeight="520" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBackground}">

    <!-- A title, a body and a close button. Used for the help topics and for reporting how
         a backup ended.

         The colours used to be hard-coded Catppuccin Mocha values here, from a dark theme
         that never existed: a #1E1E2E window in an app whose background is #F5F5F5. It went
         unnoticed because nothing ever opened this dialog. -->

    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushBtnLight}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBtnLightText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushBtnLightHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushTextTitle}" FontSize="18" FontWeight="Bold"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="TxtContent"
                       Foreground="{DynamicResource BrushTextNormal}" FontSize="13"
                       TextWrapping="Wrap" LineHeight="22"/>
        </ScrollViewer>

        <!-- BtnAction only appears when the dialog is asking something; see the
             code-behind. Laid out right to left so Fechar keeps its place either way. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAction" Style="{StaticResource CloseButton}"
                    Visibility="Collapsed" Margin="0,0,8,0"
                    Click="BtnAction_Click"/>
            <!-- IsCancel is what closes this: on a dialog it sets DialogResult to false and
                 shuts the window, and it brings Esc with it. No Click handler on purpose —
                 a Close() alongside it would be a second mechanism racing the first. -->
            <Button x:Name="BtnClose" Content="Fechar" Style="{StaticResource CloseButton}"
                    IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
