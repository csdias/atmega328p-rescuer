<Window x:Class="ATMegaPestaV1.Views.EncerramentoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A encerrar"
        SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushFundoCard}"
        FontFamily="{DynamicResource FonteUI}"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrushBtnClaro}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBtnClaroText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RaioPequeno}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource BrushMenuAccento}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,26">

        <TextBlock Text="A aplicação vai encerrar"
                   FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource BrushTextoTitulo}"/>

        <TextBlock FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource BrushTextoNormal}"
                   Text="Sem a programação de alta tensão não é possível restaurar as configurações deste microcontrolador."/>

        <!-- A contagem é a informação principal: quem quer cancelar precisa de saber
             quanto tempo tem, e quem não quer não precisa de fazer nada. -->
        <TextBlock x:Name="TxtContagem"
                   FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Margin="0,18,0,0"
                   Foreground="{DynamicResource BrushPinAviso}"/>

        <Button x:Name="BtnCancelar" Style="{StaticResource DialogButton}"
                Content="Cancelar a saída" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Center" Margin="0,20,0,0"
                Click="BtnCancelar_Click"/>

        <TextBlock FontSize="12" TextAlignment="Center" Margin="0,10,0,0"
                   Foreground="{DynamicResource BrushTextoSubtil}"
                   Text="Cancelar mantém a aplicação aberta para continuar a navegar."/>

    </StackPanel>
</Window>
