<Window x:Class="ATMegaPestaV1.Views.HighVoltageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programação de alta tensão"
        SizeToContent="Height" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushCardBackground}"
        FontFamily="{DynamicResource FontUI}">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrushBtnDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBtnDarkText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource BrushMenuAccent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButtonPrimario" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{DynamicResource BrushBtnLight}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBtnLightText}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,26">

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
            <TextBlock Text="⚡" FontSize="26" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushPinWarning}" Margin="0,0,10,0"/>
            <TextBlock Text="Restauro das configurações"
                       FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextTitle}"/>
        </StackPanel>

        <TextBlock FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21"
                   Foreground="{DynamicResource BrushTextNormal}"
                   Text="Para restaurar as configurações é necessário efetuar a programação de alta tensão. Gostaria de efetuar essa programação agora?"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Button x:Name="BtnSim" Style="{StaticResource DialogButtonPrimario}"
                    Content="Sim" IsDefault="True" Margin="0,0,12,0"
                    Click="BtnYes_Click"/>
            <Button x:Name="BtnNao" Style="{StaticResource DialogButton}"
                    Content="Não" IsCancel="True"
                    Click="BtnNo_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
