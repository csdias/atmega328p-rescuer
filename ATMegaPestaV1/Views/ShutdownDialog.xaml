<Window x:Class="ATMegaPestaV1.Views.ShutdownDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A encerrar"
        SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushCardBackground}"
        FontFamily="{DynamicResource FontUI}"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrushBtnLight}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBtnLightText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource BrushMenuAccent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,26">

        <TextBlock Text="A aplicação vai encerrar"
                   FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource BrushTextTitle}"/>

        <TextBlock FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource BrushTextNormal}"
                   Text="Sem a programação de alta tensão não é possível restaurar as configurações deste microcontrolador."/>

        <!-- The countdown is the main information: whoever wants to cancel needs to
             know how long they have, and whoever does not need do nothing. -->
        <TextBlock x:Name="TxtCountdown"
                   FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Margin="0,18,0,0"
                   Foreground="{DynamicResource BrushPinWarning}"/>

        <Button x:Name="BtnCancel" Style="{StaticResource DialogButton}"
                Content="Cancelar a saída" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Center" Margin="0,20,0,0"
                Click="BtnCancel_Click"/>

        <TextBlock FontSize="12" TextAlignment="Center" Margin="0,10,0,0"
                   Foreground="{DynamicResource BrushTextSubtle}"
                   Text="Cancelar mantém a aplicação aberta para continuar a navegar."/>

    </StackPanel>
</Window>
