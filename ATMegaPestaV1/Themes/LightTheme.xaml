<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fundos -->
    <SolidColorBrush x:Key="BrushFundoJanela"   Color="#F5F5F5"/>
    <SolidColorBrush x:Key="BrushFundoHeader"   Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BrushFundoMenu"     Color="#E8E8E8"/>
    <SolidColorBrush x:Key="BrushFundoCard"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushFundoSubCard"  Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BrushFundoInput"    Color="#EBEBEB"/>
    <SolidColorBrush x:Key="BrushSeparador"     Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BrushRealce"        Color="#FFFFFF"/>

    <!-- Relevo: aqui é plano — a moldura é uma linha e mais nada. Os dois nomes
         sobrevivem porque as vistas distinguem os dois lados do bisel. -->
    <SolidColorBrush x:Key="BrushRelevoAfundado" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BrushRelevoElevado"  Color="#CCCCCC"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="BrushTextoTitulo"   Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BrushTextoNormal"   Color="#444444"/>
    <SolidColorBrush x:Key="BrushTextoSubtil"   Color="#888888"/>
    <SolidColorBrush x:Key="BrushTextoDesativ"  Color="#BBBBBB"/>

    <!-- Accento -->
    <SolidColorBrush x:Key="BrushMenuAccento"   Color="#555555"/>

    <!-- Botão Claro (PrimaryButton) -->
    <SolidColorBrush x:Key="BrushBtnClaro"      Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BrushBtnClaroHover" Color="#333333"/>
    <SolidColorBrush x:Key="BrushBtnClaroText"  Color="#FFFFFF"/>

    <!-- Botão Escuro (DarkButton) -->
    <SolidColorBrush x:Key="BrushBtnEscuro"     Color="#DDDDDD"/>
    <SolidColorBrush x:Key="BrushBtnEscuroHover" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BrushBtnEscuroText" Color="#1A1A1A"/>

    <!-- Botão Desactivado -->
    <SolidColorBrush x:Key="BrushBtnDesativ"    Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BrushBtnDesativText" Color="#999999"/>

    <!-- Pinos -->
    <SolidColorBrush x:Key="BrushPin"           Color="#DDDDDD"/>
    <SolidColorBrush x:Key="BrushPinText"       Color="#1A1A1A"/>

    <!-- Tags -->
    <SolidColorBrush x:Key="BrushTag"           Color="#E2E2E2"/>
    <SolidColorBrush x:Key="BrushTagText"       Color="#333333"/>

    <!-- Badge -->
    <SolidColorBrush x:Key="BrushBadge"         Color="#6B7280"/>
    <SolidColorBrush x:Key="BrushBadgeText"     Color="#FFFFFF"/>

    <!-- Progresso -->
    <SolidColorBrush x:Key="BrushProgressoBg"   Color="#DDDDDD"/>
    <SolidColorBrush x:Key="BrushProgressoBar"  Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BrushProgressoText" Color="#1A1A1A"/>

    <!-- Semântico: estados -->
    <SolidColorBrush x:Key="BrushErro"          Color="#D9222B"/>
    <SolidColorBrush x:Key="BrushErroText"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSucesso"       Color="#2D7A4F"/>
    <SolidColorBrush x:Key="BrushSucessoText"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushAviso"         Color="#D97706"/>
    <SolidColorBrush x:Key="BrushAvisoText"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushPinErro"       Color="#D9222B"/>
    <SolidColorBrush x:Key="BrushPinSucesso"    Color="#2D7A4F"/>
    <SolidColorBrush x:Key="BrushPinAviso"      Color="#D97706"/>
    <SolidColorBrush x:Key="BrushPinInactivo"   Color="#CCCCCC"/>

    <!-- Geometria e tipografia. Os nomes são por peso, não por sítio, para uma
         medida servir vários controlos. -->
    <FontFamily x:Key="FonteUI">Segoe UI</FontFamily>
    <Thickness  x:Key="EspessuraBotao">0</Thickness>
    <Thickness  x:Key="EspessuraCartao">0</Thickness>
    <CornerRadius x:Key="RaioTenue">2</CornerRadius>
    <CornerRadius x:Key="RaioPequeno">4</CornerRadius>
    <CornerRadius x:Key="RaioMedio">6</CornerRadius>
    <CornerRadius x:Key="RaioGrande">8</CornerRadius>
    <CornerRadius x:Key="RaioEnorme">12</CornerRadius>
    <CornerRadius x:Key="RaioPilula">11</CornerRadius>
    <CornerRadius x:Key="RaioTopo">8,8,0,0</CornerRadius>

</ResourceDictionary>
