<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BrushWindowBackground"   Color="#F5F5F5"/>
    <SolidColorBrush x:Key="BrushHeaderBackground"   Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BrushMenuBackground"     Color="#E8E8E8"/>
    <SolidColorBrush x:Key="BrushCardBackground"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSubCardBackground"  Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BrushInputBackground"    Color="#EBEBEB"/>
    <SolidColorBrush x:Key="BrushSeparator"     Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BrushHighlight"        Color="#FFFFFF"/>

    <!-- Bevel: flat here — the frame is a line and nothing more. Both names survive
         because the views distinguish the two sides of the bevel. -->
    <SolidColorBrush x:Key="BrushBevelSunken" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BrushBevelRaised"  Color="#CCCCCC"/>

    <!-- Text -->
    <SolidColorBrush x:Key="BrushTextTitle"   Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BrushTextNormal"   Color="#444444"/>
    <SolidColorBrush x:Key="BrushTextSubtle"   Color="#888888"/>
    <SolidColorBrush x:Key="BrushTextDisabled"  Color="#BBBBBB"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="BrushMenuAccent"   Color="#555555"/>

    <!-- Light button (PrimaryButton) -->
    <SolidColorBrush x:Key="BrushBtnLight"      Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BrushBtnLightHover" Color="#333333"/>
    <SolidColorBrush x:Key="BrushBtnLightText"  Color="#FFFFFF"/>

    <!-- Dark button (DarkButton) -->
    <SolidColorBrush x:Key="BrushBtnDark"     Color="#DDDDDD"/>
    <SolidColorBrush x:Key="BrushBtnDarkHover" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BrushBtnDarkText" Color="#1A1A1A"/>

    <!-- Disabled button -->
    <SolidColorBrush x:Key="BrushBtnDisabled"    Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BrushBtnDisabledText" Color="#999999"/>

    <!-- Pins -->
    <SolidColorBrush x:Key="BrushPin"           Color="#DDDDDD"/>
    <SolidColorBrush x:Key="BrushPinText"       Color="#1A1A1A"/>

    <!-- Tags -->
    <SolidColorBrush x:Key="BrushTag"           Color="#E2E2E2"/>
    <SolidColorBrush x:Key="BrushTagText"       Color="#333333"/>

    <!-- Badge -->
    <SolidColorBrush x:Key="BrushBadge"         Color="#6B7280"/>
    <SolidColorBrush x:Key="BrushBadgeText"     Color="#FFFFFF"/>

    <!-- Progress -->
    <SolidColorBrush x:Key="BrushProgressBg"   Color="#DDDDDD"/>
    <SolidColorBrush x:Key="BrushProgressBar"  Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BrushProgressText" Color="#1A1A1A"/>

    <!-- Semantic: states -->
    <SolidColorBrush x:Key="BrushError"          Color="#D9222B"/>
    <SolidColorBrush x:Key="BrushErrorText"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSuccess"       Color="#2D7A4F"/>
    <SolidColorBrush x:Key="BrushSuccessText"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushWarning"         Color="#D97706"/>
    <SolidColorBrush x:Key="BrushWarningText"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushPinError"       Color="#D9222B"/>
    <SolidColorBrush x:Key="BrushPinSuccess"    Color="#2D7A4F"/>
    <SolidColorBrush x:Key="BrushPinWarning"      Color="#D97706"/>
    <SolidColorBrush x:Key="BrushPinIdle"   Color="#CCCCCC"/>

    <!-- Geometry and typography. The names go by weight, not by place, so one
         measurement can serve several controls. -->
    <FontFamily x:Key="FontUI">Segoe UI</FontFamily>
    <Thickness  x:Key="ButtonThickness">0</Thickness>
    <Thickness  x:Key="CardThickness">0</Thickness>
    <CornerRadius x:Key="RadiusTiny">2</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="RadiusHuge">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">11</CornerRadius>
    <CornerRadius x:Key="RadiusTop">8,8,0,0</CornerRadius>

</ResourceDictionary>
