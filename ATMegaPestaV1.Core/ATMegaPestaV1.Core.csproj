<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Serviços da bancada, sem UI. Existe para o WPF e a API partilharem o mesmo
    acesso ao hardware em vez de cada front end trazer o seu: quem fala com o
    master, com o USBAsp ou com o WMI é este projecto, e só ele.

    net10.0-windows porque a bancada é Windows por inteiro — WMI para enumerar o
    USB e avrdude.exe para chegar ao chip-alvo.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ATMegaPestaV1</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
    <PackageReference Include="System.IO.Ports" Version="9.0.4" />
    <PackageReference Include="System.Management" Version="9.0.4" />
  </ItemGroup>

</Project>
